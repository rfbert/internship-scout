# Copy to .env — the defaults below match the local Docker database
# (docker compose up -d). DATABASE_URL is the only variable you need to run.

# --- Database (required) ---
DATABASE_URL="postgresql://scout:scout_dev_pw@localhost:5432/internship_scout"
# A separate throwaway database for `npm run test:integration`. The integration
# suite truncates tables between tests, so never point this at a database you
# care about:
# TEST_DATABASE_URL="postgresql://scout:scout_dev_pw@localhost:5432/internship_scout_test"

# --- Seeded account (npm run db:seed) ---
# The defaults are neutral placeholders, which is what the demo dataset ships
# with. Set your own to seed the app against a real identity instead.
# SEED_USER_EMAIL=you@example.com
# SEED_USER_NAME=Your Name
# SEED_TIMEZONE=America/Los_Angeles
# SEED_GRADUATION_DATE=2028-06-15

# --- App ---
# APP_BASE_URL=http://localhost:3000

# --- Public demo ---
# Makes this deployment safe to hand to strangers: global and destructive
# actions are refused, and /api/demo/reset rebuilds the dataset. Off unless it
# says 1 or true — see docs/ARCHITECTURE.md.
# DEMO_MODE=1
# Vercel signs cron invocations with this; required for the nightly reset if set.
# CRON_SECRET=
